<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================== -->
    <!-- CORE PERMISSIONS -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===================================================== -->
    <!-- CONNECTED DEVICE -->
    <!-- ===================================================== -->

    <!-- Keep only ONE declaration -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- ===================================================== -->
    <!-- PACKAGE / SYSTEM ACCESS -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <uses-permission
        android:name="android.permission.WAKE_LOCK" />

    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ===================================================== -->
    <!-- OVERLAY -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="FullScreenIntentPolicy" />

    <!-- ===================================================== -->
    <!-- USAGE STATS -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===================================================== -->
    <!-- LOCATION -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="BackgroundLocation,BackgroundLocationPolicy" />

    <!-- ===================================================== -->
    <!-- PHONE -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission
        android:name="android.permission.READ_PHONE_NUMBERS" />

    <uses-permission
        android:name="android.permission.READ_CALL_LOG"
        tools:ignore="SmsAndCallLogPolicy" />

    <uses-permission
        android:name="android.permission.PROCESS_OUTGOING_CALLS"
        tools:ignore="SmsAndCallLogPolicy" />

    <!-- ===================================================== -->
    <!-- SMS -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:ignore="SmsAndCallLogPolicy" />

    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:ignore="SmsAndCallLogPolicy" />

    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:ignore="SmsAndCallLogPolicy" />

    <!-- ===================================================== -->
    <!-- CONTACTS -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.READ_CONTACTS" />

    <!-- ===================================================== -->
    <!-- CAMERA -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.CAMERA" />

    <!-- ===================================================== -->
    <!-- FOREGROUND SERVICES -->
    <!-- ===================================================== -->

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />

    <!-- Location foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        Temporarily retained because existing services still
        declare dataSync.

        We will remove this after migrating:
        - MonitoringService
        - AppSyncService
        - ScreenTimeService
        - ChildAppControlService
        - SelfHealingService
        - OverlayLockService
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Media projection -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- ===================================================== -->
    <!-- FEATURES -->
    <!-- ===================================================== -->

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ===================================================== -->
    <!-- QUERIES -->
    <!-- ===================================================== -->

    <queries>

        <intent>
            <action
                android:name="android.intent.action.MAIN" />
        </intent>

    </queries>

    <!-- ===================================================== -->
    <!-- APPLICATION -->
    <!-- ===================================================== -->

    <application
        android:name=".ChildApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:fullBackupContent="false"
        android:theme="@style/Theme.ChildApp">

        <!-- ================================================= -->
        <!-- ANDROIDX STARTUP / WORKMANAGER -->
        <!-- ================================================= -->

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />

        </provider>

        <!-- ================================================= -->
        <!-- ACTIVITIES -->
        <!-- ================================================= -->

        <activity
            android:name=".LauncherActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <activity
            android:name=".service.BlockOverlayActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".SetupWizardActivity"
            android:exported="false" />

        <activity
            android:name=".PairChildActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".DebugResetActivity"
            android:exported="true" />

        <!-- ================================================= -->
        <!-- BOOT RECEIVER -->
        <!-- ================================================= -->

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />

                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED" />

                <!-- TEMPORARY TEST -->
                <action
                    android:name="com.parentalcontrol.childapp.TEST_BOOT" />

            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- POWER / USER STATE RECEIVER -->
        <!-- ================================================= -->

        <receiver
            android:name=".receiver.PowerStateReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.USER_PRESENT" />

                <action
                    android:name="android.intent.action.SCREEN_ON" />

                <action
                    android:name="android.intent.action.ACTION_POWER_CONNECTED" />

                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED" />

            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- DAILY RESET -->
        <!-- ================================================= -->

        <receiver
            android:name=".DailyResetReceiver"
            android:exported="false" />

        <!-- ================================================= -->
        <!-- DEVICE ADMIN -->
        <!-- ================================================= -->

        <receiver
            android:name=".admin.ChildAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">

            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>

                <action
                    android:name="android.app.action.DEVICE_ADMIN_ENABLED" />

            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- SMS RECEIVER -->
        <!-- ================================================= -->

        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">

            <intent-filter>

                <action
                    android:name="android.provider.Telephony.SMS_RECEIVED" />

            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- CALL RECEIVER -->
        <!-- ================================================= -->

        <receiver
            android:name=".receiver.CallReceiver"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.PHONE_STATE" />

                <action
                    android:name="android.intent.action.NEW_OUTGOING_CALL" />

            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- CONTINUOUS APP CONTROL -->
        <!-- ================================================= -->

        <service
            android:name=".service.ChildAppControlService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ================================================= -->
        <!-- LEGACY BOOT SERVICE -->
        <!-- ================================================= -->
        <!--
            Kept temporarily so existing references do not break.

            We will remove this after BootStartupService references
            have been migrated to the new recovery architecture.
        -->

        <service
            android:name=".service.BootStartupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ================================================= -->
        <!-- MESSAGE SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".receiver.MessageService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ================================================= -->
        <!-- LOCATION SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".service.ChildLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- ================================================= -->
        <!-- SCREEN CAPTURE -->
        <!-- ================================================= -->

        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ================================================= -->
        <!-- MONITORING SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".service.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ================================================= -->
        <!-- VPN SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".vpn.DnsVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="VpnServicePolicy">

            <!--
                Required by Android for a VpnService.
                This allows Android to recognize this component
                as a VPN service.
            -->
            <intent-filter>

                <action
                    android:name="android.net.VpnService" />

            </intent-filter>

        </service>

        <!-- ================================================= -->
        <!-- ACCESSIBILITY SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".accessibility.BrowserAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true"
            tools:ignore="AccessibilityPolicy">

            <intent-filter>

                <action
                    android:name="android.accessibilityservice.AccessibilityService" />

            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/browser_accessibility_config" />

        </service>

        <!-- ================================================= -->
        <!-- SCREEN-TIME OVERLAY LOCK -->
        <!-- ================================================= -->

        <service
            android:name=".OverlayLockService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ================================================= -->
        <!-- PHONE CALL SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".receiver.CallService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ================================================= -->
        <!-- APP SYNCHRONIZATION -->
        <!-- ================================================= -->

        <service
            android:name=".service.AppSyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ================================================= -->
        <!-- SCREEN TIME SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".service.ScreenTimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ================================================= -->
        <!-- NOTIFICATION LISTENER -->
        <!-- ================================================= -->

        <service
            android:name=".service.NotificationMonitorService"
            android:label="Notification Monitor"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.service.notification.NotificationListenerService" />

            </intent-filter>

        </service>

        <!-- ================================================= -->
        <!-- SELF HEALING -->
        <!-- ================================================= -->

        <service
            android:name=".service.SelfHealingService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ================================================= -->
        <!-- APP BLOCK OVERLAY -->
        <!-- ================================================= -->

        <activity
            android:name=".service.AppBlockOverlayActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

    </application>

</manifest>